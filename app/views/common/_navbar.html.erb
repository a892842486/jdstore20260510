<nav class="bg-white shadow">
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    <div class="flex items-center">
      <%= link_to root_path,
          class: "bg-red-600 text-white px-6 py-4 text-xl font-bold flex items-center hover:bg-red-700 transition" do %>

        <span class="tracking-wide">
          <%= t("navbar.brand") %>
        </span>
      <% end %>
      <%= link_to t("navbar.products") || t("navbar.products"),
          products_path,
          class: "ml-3 inline-flex items-center px-5 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition" %>
    </div>
    <div class="flex items-center space-x-4">
      <div class="flex justify-end space-x-4">
          <% current_locale = I18n.locale %>

          <% zh_path =
              if controller_name == "orders" && action_name == "create"
                checkout_carts_path(locale: "zh-TW")
              else
                url_for(locale: "zh-TW")
              end
          %>

          <% en_path =
              if controller_name == "orders" && action_name == "create"
                checkout_carts_path(locale: "en")
              else
                url_for(locale: "en")
              end
          %>

          <div class="flex items-center rounded-full border border-gray-300 bg-white p-1 text-sm shadow-sm">
            <%= link_to "中文",
                zh_path,
                class: "rounded-full px-3 py-1 transition #{current_locale == :'zh-TW' ? 'bg-blue-500 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900'}" %>

            <%= link_to "EN",
                en_path,
                class: "rounded-full px-3 py-1 transition #{current_locale == :en ? 'bg-blue-500 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900'}" %>
          </div>

        <%= link_to carts_path, class: "flex items-center text-gray-700 hover:text-gray-900" do %>
          <!-- SVG shopping cart icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 5h13M17 13l2 5M6 18a1 1 0 11-2 0 1 1 0 012 0zm12 0a1 1 0 11-2 0 1 1 0 012 0z"/>
          </svg>
          <%= t("navbar.cart") %> (<%= current_cart.cart_items.sum(:quantity) %>)
        <% end %>
      </div>

      <% if !current_user %>
        <%= link_to t("navbar.register"), new_user_registration_path,
            class: "text-gray-700 hover:text-blue-500" %>

        <%= link_to t("navbar.login"), new_user_session_path,
            class: "text-gray-700 hover:text-blue-500" %>

      <% else %>
        <div class="relative group">
          <!-- 按鈕 -->
          <button class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 transition">
            Hi, <%= current_user.email %>

            <svg xmlns="http://www.w3.org/2000/svg"
                 class="h-4 w-4 ml-2"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown -->
          <div class="absolute right-0 mt-0 pt-2 w-48
                      opacity-0 invisible group-hover:opacity-100 group-hover:visible
                      transition duration-150 z-50">

            <div class="bg-white border border-gray-200 rounded-lg shadow-lg">
              <% if current_user&.admin? %>
                <%= link_to t("navbar.admin_products"), admin_products_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
              <% end %>
              <%= link_to t("navbar.order_history"), account_orders_path,
                       class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>

              <div class="border-t border-gray-100"></div>

              <%= link_to destroy_user_session_path,
                  data: { turbo_method: :delete },
                  class: "flex items-center px-4 py-2 text-sm text-red-500 hover:bg-red-50" do %>

                  <svg xmlns="http://www.w3.org/2000/svg"
                       class="h-4 w-4 mr-2"
                       fill="none"
                       viewBox="0 0 24 24"
                       stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 16l4-4m0 0l-4-4m4 4H7" />
                  </svg>

                <%= t("navbar.logout") %>
              <% end %>
            </div>
          </div>

        </div>
      <% end %>
    </div>
  </div>
</nav>
